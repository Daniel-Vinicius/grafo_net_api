@startuml
!pragma layout smetana

top to bottom direction

skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam nodesep 45
skinparam ranksep 55
skinparam ArrowColor #294A63
skinparam PackageBorderColor #294A63
skinparam PackageBackgroundColor #EAF3FA
skinparam PackageFontColor #173247
skinparam ClassBorderColor #708898
skinparam ClassBackgroundColor #F7FAFC
skinparam ClassFontColor #173247
skinparam rectangle {
  BackgroundColor transparent
  BorderColor transparent
  FontColor transparent
}

hide empty members
allowmixing

package "search" as Busca {
  class SearchUseCase <<caso de uso>>
  class IndexProfilesUseCase <<caso de uso>>
  interface EmbeddingProvider
  class GeminiEmbeddings <<adaptador REST>>
  interface EmbeddingRepository
}

package "graph" as Grafo {
  class NetworkGraph
  class GraphUseCase <<caso de uso>>
  class PathTree
  class "Caminho (Path)" as Caminho
  class Edge
  interface ProfileRepository
  class Catalogs <<catálogos auxiliares>>
}

package "connections" as Conexoes {
  class Connection
  class ConnectionUseCase <<caso de uso>>
  interface ConnectionRepository
}

package "auth (contas e perfis)" as Contas {
  class User
  class Profile
  class Invite
}

Busca ..> Grafo : relevância + custo do caminho
Grafo ..> Conexoes : amizades aceitas
Grafo ..> Contas : perfis e participações
Conexoes ..> Contas : identidade e atividade
GeminiEmbeddings ..|> EmbeddingProvider
User "1" -- "1" Profile : profiles._id = users._id
ProfileRepository ..> Profile : modelo compartilhado
IndexProfilesUseCase ..> Profile : campos permitidos

note bottom of Busca
  Gemini gera vetores; comparação é local.
  Auth chama o hook após salvar o perfil.
  Vetores persistidos em profile_embeddings.
end note

note bottom of Grafo
  Pessoas são vértices; vínculos são arestas.
  Custo = (contextuais, etapas).
  Caminhos calculados, sem coleção própria.
end note

@enduml
