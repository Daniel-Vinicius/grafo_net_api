@startuml
!pragma layout smetana
top to bottom direction

skinparam backgroundColor white
skinparam shadowing false
skinparam linetype ortho
skinparam defaultFontName Arial
skinparam nodesep 65
skinparam ranksep 65
skinparam ArrowColor #294A63
skinparam ClassBorderColor #294A63
skinparam ClassBackgroundColor #EAF3FA
skinparam ClassFontColor #173247
skinparam ClassAttributeIconSize 0

hide circle

class Usuario {
  - id: UUID
  - emailInsper: String
  - senhaHash: String
  - tipo: TipoUsuario
  - ativo: Boolean
  + autenticar(senha: String): Boolean
  + enviarConvite(email: String): Convite
}

class Convite {
  - id: UUID
  - emailConvidado: String
  - token: String
  - criadoEm: DateTime
  - expiraEm: DateTime
  - status: StatusConvite
  + estaValido(): Boolean
  + aceitar(): void
}

class Perfil {
  - nome: String
  - bio: String
  - curso: String
  - semestreIngresso: String
  - turma: String
  - areaAtuacao: String
  - interesses: List<String>
  + atualizarDados(): void
}

class Experiencia {
  - id: UUID
  - titulo: String
  - organizacao: String
  - tipo: String
  - inicio: Date
  - fim: Date
  - descricao: String
}

class Entidade {
  - id: UUID
  - nome: String
}

class ParticipacaoEntidade {
  - funcao: String
  - inicio: Date
  - fim: Date
}

class IniciacaoCientifica {
  - id: UUID
  - titulo: String
  - tema: String
  - inicio: Date
  - fim: Date
}

class ParticipacaoPesquisa {
  - id: UUID
  - orientadorUserId: UUID
  - status: pendente | confirmada
  - inicio: Date
  - fim: Date?
}

class ConexaoProxima {
  - id: UUID
  - status: StatusConexao
  - solicitadaEm: DateTime
  - confirmadaEm: DateTime
  - solicitanteId: UUID
  + confirmar(): void
  + recusar(): void
}

class SearchUseCase <<caso de uso>> {
  + buscar(texto, modo, limite, offset): ResultadoBusca
}

class GraphUseCase <<caso de uso>> {
  + snapshot(): Grafo
}

class Caminho {
  - userIds: List<UUID>
  - vinculosContextuais: Integer
  - saltos: Integer
}

class EtapaCaminho {
  - ordem: Integer
  - tipo: TipoVinculo
  - contexto: String
  - origemId: UUID
  - destinoId: UUID
  - referenciaId: String
}

class Aresta {
  - id: String
  - origemId: UUID
  - destinoId: UUID
  - tipo: close | class | entity | ic
  - contexto: JSON
}

class Grafo {
  - perfis: Map<UUID, PerfilPublico>
  - adjacencias: Map<UUID, List<Aresta>>
}

class EmbeddingPerfil {
  - userId: UUID
  - vetor: List<Float>
  - modelo: String
  - dimensao: Integer
  - versaoTexto: Integer
  - hashTexto: String
  - status: pending | ready
}

class IndexProfilesUseCase <<caso de uso>> {
  + atualizar(userId): void
  + reindexar(): void
}

interface ProvedorEmbeddings {
  + documento(texto, titulo): List<Float>
  + consulta(texto): List<Float>
}

class GeminiEmbeddings <<adaptador REST>>

class ResultadoBusca {
  - resultados: List<PerfilPublico, similaridade, Caminho?>
  - total: Integer
  - grafo: JSON
}

Usuario "1" *-right- "1" Perfil : possui
Usuario "1" -up-> "0..*" Convite : envia

Perfil "1" *-down- "0..*" Experiencia : registra
Perfil "1" *-down- "0..*" ParticipacaoEntidade
ParticipacaoEntidade "0..*" -down-> "1" Entidade
Perfil "1" *-- "0..*" ParticipacaoPesquisa
ParticipacaoPesquisa "0..*" --> "1" IniciacaoCientifica : projeto
ParticipacaoPesquisa "0..*" --> "1" Usuario : orientador confirmado

Perfil "2" -left- "0..10" ConexaoProxima : participa

SearchUseCase .down.> Perfil
SearchUseCase ..> ResultadoBusca
SearchUseCase ..> IndexProfilesUseCase
SearchUseCase ..> GraphUseCase
GraphUseCase .down.> Grafo : Dijkstra por custo lexicográfico
GraphUseCase .right.> Caminho
Caminho "1" *-down- "0..*" EtapaCaminho
EtapaCaminho "0..*" -left-> "2" Perfil : liga
Grafo *-- "0..*" Aresta
IndexProfilesUseCase ..> EmbeddingPerfil : persiste e invalida por hash
IndexProfilesUseCase ..> ProvedorEmbeddings
SearchUseCase ..> ProvedorEmbeddings : apenas vetor da consulta
GeminiEmbeddings ..|> ProvedorEmbeddings
Usuario "1" -- "0..1" EmbeddingPerfil

note bottom of Perfil
  JSON dentro de users; identidade = user.id.
  Participações ficam no perfil.
  Campos opcionais permitem perfil parcial.
end note

note bottom of Caminho
  Custo = (vínculos contextuais, saltos).
  Calculado em memória; não persistido.
  Ausência de caminho é null.
end note

@enduml
